---
// Visual ilustrativo de finanzas personales: cuentas + movimientos recientes.
import { Landmark, PiggyBank, CreditCard, Briefcase, ShoppingCart, Home, Zap } from "lucide-react";

const accounts = [
  { icon: Landmark, name: "Cuenta nómina", balance: "4.218,40 €" },
  { icon: PiggyBank, name: "Ahorro", balance: "12.500,00 €" },
  { icon: CreditCard, name: "Tarjeta", balance: "−312,15 €", negative: true },
];
const tx = [
  { icon: Briefcase, name: "Nómina abril", cat: "Ingresos", amount: "+1.892,00 €", income: true },
  { icon: Home, name: "Alquiler", cat: "Vivienda", amount: "−750,00 €" },
  { icon: ShoppingCart, name: "Supermercado", cat: "Alimentación", amount: "−84,30 €" },
  { icon: Zap, name: "Luz", cat: "Suministros", amount: "−46,12 €" },
];
---

<div class="grid sm:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] gap-3">
  <div class="mk-card rounded-2xl p-4">
    <p class="text-[13px] font-semibold">Cuentas</p>
    <p class="text-[11px] text-muted-foreground">Saldo total</p>
    <p class="mt-1 text-2xl font-semibold tracking-tight tabular-nums">16.406,25 €</p>
    <ul class="mt-4 space-y-2.5">
      {accounts.map(({ icon: Icon, name, balance, negative }) => (
        <li class="flex items-center gap-2.5">
          <span class="w-7 h-7 rounded-lg bg-muted dark:bg-white/[0.06] flex items-center justify-center">
            <Icon className="w-3.5 h-3.5 text-foreground/70" />
          </span>
          <span class="flex-1 min-w-0 truncate text-[12px] text-foreground/80">{name}</span>
          <span class:list={["text-[12px] font-medium tabular-nums whitespace-nowrap", negative && "text-danger-600 dark:text-danger-400"]}>{balance}</span>
        </li>
      ))}
    </ul>
  </div>

  <div class="mk-card rounded-2xl p-4">
    <div class="flex items-center justify-between">
      <p class="text-[13px] font-semibold">Movimientos recientes</p>
      <span class="text-[11px] text-muted-foreground">Abril</span>
    </div>
    <ul class="mt-3 divide-y divide-border">
      {tx.map(({ icon: Icon, name, cat, amount, income }) => (
        <li class="flex items-center gap-2.5 py-2.5 first:pt-1 last:pb-0">
          <span
            class:list={[
              "w-7 h-7 rounded-lg flex items-center justify-center",
              income ? "bg-success-50 dark:bg-success-500/10 text-success-700 dark:text-success-500" : "bg-muted dark:bg-white/[0.06] text-foreground/70",
            ]}
          >
            <Icon className="w-3.5 h-3.5" />
          </span>
          <div class="flex-1 min-w-0">
            <p class="text-[12px] font-medium truncate">{name}</p>
            <p class="text-[10.5px] text-muted-foreground">{cat}</p>
          </div>
          <span class:list={["text-[12px] font-medium tabular-nums", income ? "text-success-700 dark:text-success-500" : ""]}>{amount}</span>
        </li>
      ))}
    </ul>
  </div>
</div>
