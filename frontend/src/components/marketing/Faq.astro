---
// FAQ con <details>/<summary> nativos: cero JavaScript (antes esto era un
// Accordion de React + Base UI hidratado con client:visible — ~211 kB en
// la landing solo para un acordeón). El navegador ya sabe abrir/cerrar
// <details>; aquí solo se le da estilo.
export interface FaqItem {
  q: string;
  a: string;
}

interface Props {
  items: FaqItem[];
}

const { items } = Astro.props;
---

<div class="mk-faq mk-card rounded-2xl px-5 sm:px-6">
  {items.map((item) => (
    <details class="mk-faq-item group border-border not-last:border-b">
      <summary class="flex cursor-pointer list-none items-start justify-between gap-3 rounded-lg py-5 text-left text-[15px] font-medium outline-none hover:underline focus-visible:ring-3 focus-visible:ring-ring/50">
        {item.q}
        <svg
          class="mt-0.5 size-4 shrink-0 text-muted-foreground transition-transform duration-200 group-open:rotate-180"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="m6 9 6 6 6-6" />
        </svg>
      </summary>
      <p class="pb-5 text-[14.5px] leading-relaxed text-muted-foreground">{item.a}</p>
    </details>
  ))}
</div>

<style>
  /* Quita el triángulo por defecto de <summary> en navegadores que no
     respetan list-style (Safari/Chromium antiguos usan su propio marcador). */
  .mk-faq-item summary::-webkit-details-marker {
    display: none;
  }
</style>
