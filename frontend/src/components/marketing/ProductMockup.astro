---
// Ilustración estática del producto para el hero — datos de ejemplo
// redondos y ficticios, presentados como maqueta de interfaz, no como
// captura real ni como testimonio de un usuario.
const concepts = [
  { label: "Salario Base", value: 62, tone: "bg-foreground/70" },
  { label: "Plus Convenio", value: 38, tone: "bg-foreground/50" },
  { label: "Antigüedad", value: 18, tone: "bg-foreground/30" },
  { label: "IRPF", value: -22, tone: "bg-danger-400" },
];
---

<div class="relative">
  <!-- Marca de "maqueta" sutil -->
  <div
    class="absolute -inset-3 md:-inset-4 rounded-[1.75rem] bg-primary-50 dark:bg-primary-950/40 -z-10"
    aria-hidden="true"
  >
  </div>

  <div class="rounded-2xl border border-border bg-card shadow-[0_1px_2px_rgba(0,0,0,0.04)] overflow-hidden">
    <!-- Barra de ventana -->
    <div class="flex items-center gap-1.5 px-4 h-9 border-b border-border bg-muted/40">
      <span class="w-2.5 h-2.5 rounded-full bg-border"></span>
      <span class="w-2.5 h-2.5 rounded-full bg-border"></span>
      <span class="w-2.5 h-2.5 rounded-full bg-border"></span>
      <span class="ml-3 text-[11px] font-medium text-muted-foreground">Dashboard · SueldIA</span>
    </div>

    <div class="p-5 md:p-6 space-y-5">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-[11px] font-medium text-muted-foreground uppercase tracking-wide">Nómina · Abril 2026</p>
          <p class="text-sm font-semibold mt-0.5">THENEXTPANGEA SL</p>
        </div>
        <span class="inline-flex items-center gap-1 rounded-full bg-success-50 dark:bg-success-700/20 text-success-700 dark:text-success-500 text-[11px] font-semibold px-2.5 py-1">
          +2,3% vs. marzo
        </span>
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div class="rounded-xl border border-border p-3.5">
          <p class="text-[11px] text-muted-foreground">Bruto</p>
          <p class="text-xl font-bold tracking-tight mt-0.5">2.480 €</p>
        </div>
        <div class="rounded-xl border border-border p-3.5">
          <p class="text-[11px] text-muted-foreground">Neto</p>
          <p class="text-xl font-bold tracking-tight mt-0.5 text-primary-600 dark:text-primary-400">1.890 €</p>
        </div>
      </div>

      <div class="space-y-2.5">
        {concepts.map((c) => (
          <div class="flex items-center gap-3">
            <span class="text-xs text-muted-foreground w-24 shrink-0 truncate">{c.label}</span>
            <div class="flex-1 h-1.5 rounded-full bg-muted overflow-hidden">
              <div
                class:list={["h-full rounded-full", c.tone]}
                style={`width: ${Math.abs(c.value) * 1.4}%`}
              >
              </div>
            </div>
            <span class="text-xs font-medium tabular-nums w-12 text-right shrink-0">
              {c.value > 0 ? "+" : ""}{c.value}%
            </span>
          </div>
        ))}
      </div>
    </div>
  </div>

  <p class="mt-3 text-center text-[11px] text-muted-foreground">Ejemplo ilustrativo — no son datos reales</p>
</div>
