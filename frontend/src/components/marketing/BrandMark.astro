---
interface Props {
  size?: "sm" | "md";
  wordmark?: boolean;
}
const { size = "md", wordmark = true } = Astro.props;
const mark = size === "sm" ? "w-7 h-7" : "w-8 h-8";
const text = size === "sm" ? "text-[15px]" : "text-[16px]";
---

<span class="inline-flex items-center gap-2.5">
  <img src="/logo-mark.svg" alt="" class:list={[mark, "shrink-0"]} width="32" height="32" />
  {wordmark && (
    <span class:list={[text, "font-bold tracking-[-0.02em] leading-none"]}>
      <span class="text-foreground">Sueld</span><span class="text-primary-500 dark:text-primary-400">IA</span>
    </span>
  )}
</span>
