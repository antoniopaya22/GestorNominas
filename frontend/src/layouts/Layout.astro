---
import "../styles/global.css";
import {
  Home, Wallet, ChartColumn, Landmark, Tags, Receipt, ArrowDownToLine,
  FileText, Upload, Users, Settings, PieChart,
} from "lucide-react";

interface Props {
  title: string;
}

const { title } = Astro.props;
const currentPath = Astro.url.pathname;
const normalizedCurrentPath = currentPath !== "/app" && currentPath.endsWith("/")
  ? currentPath.slice(0, -1)
  : currentPath;

function isActivePath(href: string, exact = false): boolean {
  if (href === "/app") {
    return normalizedCurrentPath === "/app";
  }
  if (exact) {
    return normalizedCurrentPath === href;
  }
  return normalizedCurrentPath === href || normalizedCurrentPath.startsWith(`${href}/`);
}

const navItems = [
  { href: "/app", label: "Inicio", icon: Home },
  { href: "/app/finance", label: "Dashboard", icon: Wallet, section: "Finanzas", exact: true },
  { href: "/app/finance/analytics", label: "Analítica", icon: PieChart },
  { href: "/app/accounts", label: "Cuentas", icon: Landmark },
  { href: "/app/categories", label: "Categorías", icon: Tags },
  { href: "/app/transactions", label: "Transacciones", icon: Receipt },
  { href: "/app/import", label: "Importar", icon: ArrowDownToLine },
  { href: "/app/payroll", label: "Dashboard", icon: ChartColumn, section: "Nóminas" },
  { href: "/app/upload", label: "Subir Nóminas", icon: Upload },
  { href: "/app/payslips", label: "Mis Nóminas", icon: FileText },
  { href: "/app/analytics", label: "Analítica", icon: PieChart },
  { href: "/app/profiles", label: "Perfiles", icon: Users },
  { href: "/app/settings", label: "Ajustes", icon: Settings, section: "Sistema" },
];

const mobileNavItems = [
  { href: "/app", label: "Inicio", icon: Home },
  { href: "/app/finance", label: "Finanzas", icon: Wallet },
  { href: "/app/transactions", label: "Movimientos", icon: Receipt },
  { href: "/app/payslips", label: "Nóminas", icon: FileText },
  { href: "/app/settings", label: "Ajustes", icon: Settings },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | SueldIA</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-screen bg-muted/40">
    <div class="flex min-h-screen">
      <!-- Sidebar -->
      <aside class="hidden md:flex w-[260px] flex-col bg-card border-r border-border fixed inset-y-0 left-0 z-30">
        <a href="/" class="flex items-center gap-3 px-6 h-16 border-b border-border">
          <div class="w-8 h-8 rounded-lg bg-primary flex items-center justify-center">
            <svg class="w-4.5 h-4.5 text-primary-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
            </svg>
          </div>
          <div>
            <h1 class="text-sm font-bold text-foreground leading-tight">SueldIA</h1>
            <p class="text-[11px] text-muted-foreground leading-tight">Nóminas y finanzas</p>
          </div>
        </a>

        <nav class="flex-1 px-3 py-4 space-y-1 overflow-y-auto">
          {navItems.map((item) => {
            const isActive = isActivePath(item.href, item.exact ?? false);
            const Icon = item.icon;
            return (
              <>
                {item.section && (
                  <p class="text-[10px] font-bold text-muted-foreground uppercase tracking-widest px-3 pt-4 pb-1 first:pt-0">{item.section}</p>
                )}
                <a
                  href={item.href}
                  class:list={[
                    "group flex items-center gap-3 px-3 py-2.5 rounded-lg text-[13px] font-medium transition-all duration-150",
                    isActive
                      ? "bg-accent text-accent-foreground"
                      : "text-muted-foreground hover:bg-accent/60 hover:text-accent-foreground",
                  ]}
                >
                  <Icon className="w-[18px] h-[18px]" />
                  <span>{item.label}</span>
                </a>
              </>
            );
          })}
        </nav>

        <div class="px-4 py-3 border-t border-border">
          <p class="text-[11px] text-muted-foreground text-center">v3.0 · sueldia.app</p>
        </div>
      </aside>

      <!-- Mobile header -->
      <header class="md:hidden fixed top-0 left-0 right-0 h-14 bg-card border-b border-border z-30 flex items-center px-4 gap-3">
        <div class="w-7 h-7 rounded-lg bg-primary flex items-center justify-center flex-shrink-0">
          <svg class="w-3.5 h-3.5 text-primary-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
          </svg>
        </div>
        <span class="text-sm font-bold text-foreground">SueldIA</span>
      </header>

      <!-- Mobile bottom nav -->
      <nav class="md:hidden fixed bottom-0 left-0 right-0 h-16 bg-card border-t border-border z-30 flex items-center justify-around px-2">
        {mobileNavItems.map((item) => {
          const isActive = isActivePath(item.href);
          const Icon = item.icon;
          return (
            <a
              href={item.href}
              class:list={[
                "flex flex-col items-center gap-1 px-3 py-1.5 rounded-lg transition-colors",
                isActive ? "text-primary" : "text-muted-foreground",
              ]}
            >
              <Icon className="w-5 h-5" />
              <span class="text-[10px] font-medium">{item.label}</span>
            </a>
          );
        })}
      </nav>

      <!-- Main content -->
      <main class="flex-1 md:ml-[260px] mt-14 md:mt-0 mb-16 md:mb-0 overflow-auto min-h-screen">
        <div class="px-4 py-6 md:px-8 md:py-8 max-w-7xl mx-auto">
          <slot />
        </div>
      </main>
    </div>
  </body>
</html>
