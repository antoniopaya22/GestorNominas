---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import { buttonVariants } from "../components/ui/button";
import { Check } from "lucide-react";

const plans = [
  {
    name: "Gratis",
    price: "0€",
    period: "para siempre",
    description: "Todo lo que necesitas para gestionar tus nóminas hoy.",
    features: [
      "Nóminas y perfiles ilimitados",
      "Extracción automática de conceptos",
      "Dashboard y análisis financiero",
      "Alertas configurables",
      "Cuentas, categorías e importación YNAB",
    ],
    cta: "Empezar gratis",
    href: "/login",
    highlighted: true,
    available: true,
  },
  {
    name: "Pro",
    price: "?",
    period: "próximamente",
    description: "Para cuando el plan gratuito se quede corto.",
    features: [
      "Todo lo del plan Gratis",
      "Historial y copias de seguridad ampliadas",
      "Soporte prioritario",
    ],
    cta: "Próximamente",
    href: null,
    highlighted: false,
    available: false,
  },
];
---

<MarketingLayout title="Precios" description="SueldIA es gratis. Así de simple.">
  <section class="max-w-4xl mx-auto px-4 md:px-8 pt-20 pb-14 text-center">
    <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-balance">Precios simples</h1>
    <p class="mt-6 text-lg text-muted-foreground max-w-xl mx-auto text-balance">
      Hoy por hoy, SueldIA es completamente gratuito. Esto es lo que hay y lo que vendrá.
    </p>
  </section>

  <section class="max-w-4xl mx-auto px-4 md:px-8 pb-24">
    <div class="grid sm:grid-cols-2 gap-5">
      {plans.map((plan) => (
        <div
          class:list={[
            "rounded-2xl border bg-card p-7 flex flex-col",
            plan.highlighted ? "border-primary-600" : "border-border",
          ]}
        >
          {plan.highlighted ? (
            <span class="inline-flex w-fit items-center rounded-full bg-primary-600 text-white text-[11px] font-semibold px-2.5 py-1 mb-4">
              Disponible ahora
            </span>
          ) : (
            <span class="inline-flex w-fit items-center rounded-full bg-muted text-muted-foreground text-[11px] font-semibold px-2.5 py-1 mb-4">
              Próximamente
            </span>
          )}
          <h2 class="text-xl font-semibold">{plan.name}</h2>
          <p class="mt-1 text-sm text-muted-foreground">{plan.description}</p>
          <div class="mt-5 flex items-baseline gap-1.5">
            <span class="text-4xl font-bold tracking-tight">{plan.price}</span>
            <span class="text-sm text-muted-foreground">{plan.period}</span>
          </div>

          <ul class="mt-6 space-y-2.5 flex-1">
            {plan.features.map((feature) => (
              <li class="flex items-start gap-2 text-sm">
                <Check className="w-4 h-4 text-primary-600 dark:text-primary-400 mt-0.5 shrink-0" />
                <span class={plan.available ? "" : "text-muted-foreground"}>{feature}</span>
              </li>
            ))}
          </ul>

          <div class="mt-7">
            {plan.available ? (
              <a
                href={plan.href!}
                class="flex items-center justify-center rounded-lg bg-primary-600 hover:bg-primary-700 text-white text-sm font-medium h-10 w-full transition-colors"
              >
                {plan.cta}
              </a>
            ) : (
              <span class={buttonVariants({ variant: "outline" }) + " w-full pointer-events-none opacity-60"}>{plan.cta}</span>
            )}
          </div>
        </div>
      ))}
    </div>

    <p class="mt-8 text-center text-sm text-muted-foreground">
      ¿Preguntas sobre el plan Pro? Todavía no hay fecha — de momento, disfruta del plan gratuito sin límites.
    </p>
  </section>
</MarketingLayout>
