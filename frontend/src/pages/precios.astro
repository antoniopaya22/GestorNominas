---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import CtaBand from "../components/marketing/CtaBand.astro";
import { Faq } from "../components/marketing/Faq";
import { Check, ArrowRight, Clock } from "lucide-react";

const plans = [
  {
    name: "Gratis",
    price: "0 €",
    period: "para siempre",
    description: "Todo lo que necesitas para gestionar tus nóminas hoy.",
    features: [
      "Nóminas y perfiles ilimitados",
      "Extracción automática de conceptos",
      "Dashboard y análisis financiero",
      "Alertas configurables",
      "Cuentas, categorías e importación YNAB",
    ],
    available: true,
  },
  {
    name: "Pro",
    price: "Por definir",
    period: "",
    description: "Para cuando el plan gratuito se quede corto.",
    features: [
      "Todo lo del plan Gratis",
      "Historial y copias de seguridad ampliadas",
      "Soporte prioritario",
    ],
    available: false,
  },
];

const faqs = [
  {
    q: "¿De verdad es gratis?",
    a: "Sí. Todas las funciones actuales están incluidas en el plan gratuito, sin límite de nóminas ni de perfiles, y sin pedirte tarjeta.",
  },
  {
    q: "¿Cuándo llegará el plan Pro?",
    a: "Todavía no hay fecha. Cuando llegue será para extras como copias de seguridad ampliadas o soporte prioritario; el plan gratuito se mantiene.",
  },
  {
    q: "¿Necesito tarjeta para registrarme?",
    a: "No. Solo necesitas tu cuenta de Google para iniciar sesión.",
  },
];
---

<MarketingLayout title="Precios" description="SueldIA es gratis: nóminas y perfiles ilimitados, extracción automática, dashboard y alertas, sin tarjeta.">
  <section class="relative isolate">
    <div class="absolute inset-x-0 top-0 h-[560px] mk-dots -z-10" aria-hidden="true"></div>
    <div class="absolute inset-x-0 top-0 h-[560px] mk-halo -z-10" aria-hidden="true"></div>

    <div class="max-w-4xl mx-auto px-5 md:px-8 pt-32 md:pt-40 text-center">
      <p class="reveal mk-eyebrow">Precios</p>
      <h1 class="reveal mt-5 text-[2.6rem] sm:text-6xl md:text-7xl font-semibold tracking-[-0.045em] leading-[1.02] text-balance" data-delay="1">
        Gratis. <span class="font-display italic font-normal tracking-[-0.02em] text-[1.08em] text-primary-700 dark:text-primary-300 sm:whitespace-nowrap">Sin letra pequeña.</span>
      </h1>
      <p class="reveal mt-6 text-[17px] md:text-xl text-muted-foreground max-w-xl mx-auto text-balance leading-relaxed" data-delay="2">
        Hoy por hoy, SueldIA es completamente gratuito. Esto es lo que incluye y lo que vendrá.
      </p>
    </div>

    <div class="max-w-4xl mx-auto px-5 md:px-8 mt-14 md:mt-16 grid md:grid-cols-2 gap-5 items-stretch">
      {plans.map((plan, i) => (
        <div class="reveal relative" data-delay={String(i + 1)}>
          {plan.available && <div class="absolute inset-4 mk-glow -z-10" aria-hidden="true"></div>}
          <div
            class:list={[
              "h-full rounded-3xl p-7 sm:p-8 flex flex-col",
              plan.available
                ? "mk-card ring-2 ring-primary-500/50 dark:ring-primary-400/40 shadow-[0_30px_60px_-30px_rgb(15_23_42/0.35)]"
                : "bg-foreground/[0.025] dark:bg-white/[0.02] ring-1 ring-border",
            ]}
          >
            <div class="flex items-center justify-between">
              <h2 class="text-xl font-semibold tracking-tight">{plan.name}</h2>
              {plan.available ? (
                <span class="rounded-full bg-primary-50 dark:bg-primary-500/15 text-primary-700 dark:text-primary-300 text-[11.5px] font-medium px-2.5 py-1">Disponible ahora</span>
              ) : (
                <span class="inline-flex items-center gap-1 rounded-full bg-muted text-muted-foreground text-[11.5px] font-medium px-2.5 py-1"><Clock className="w-3 h-3" /> Próximamente</span>
              )}
            </div>
            <p class="mt-2 text-[14.5px] text-muted-foreground">{plan.description}</p>
            <div class="mt-7 flex items-baseline gap-2">
              <span class:list={["font-semibold tracking-[-0.04em] tabular-nums", plan.available ? "text-5xl" : "text-3xl text-muted-foreground"]}>{plan.price}</span>
              {plan.period && <span class="text-sm text-muted-foreground">{plan.period}</span>}
            </div>

            <div class="my-7 h-px bg-border"></div>

            <ul class="space-y-3 flex-1">
              {plan.features.map((feature) => (
                <li class="flex items-start gap-3 text-[14.5px]">
                  <span
                    class:list={[
                      "mt-0.5 w-5 h-5 shrink-0 rounded-full flex items-center justify-center",
                      plan.available ? "bg-primary-50 dark:bg-primary-500/15" : "bg-muted",
                    ]}
                  >
                    <Check className={plan.available ? "w-3 h-3 text-primary-700 dark:text-primary-300" : "w-3 h-3 text-muted-foreground"} strokeWidth={3} />
                  </span>
                  <span class={plan.available ? "text-foreground/85" : "text-muted-foreground"}>{feature}</span>
                </li>
              ))}
            </ul>

            <div class="mt-8">
              {plan.available ? (
                <a href="/login" class="mk-btn mk-btn-primary h-12 w-full rounded-full text-[15px]">
                  Empezar gratis <ArrowRight className="w-4 h-4" />
                </a>
              ) : (
                <span class="mk-btn h-12 w-full rounded-full text-[15px] ring-1 ring-border text-muted-foreground cursor-default">Próximamente</span>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-5 md:px-8 pt-28 md:pt-36">
    <div class="grid lg:grid-cols-[0.8fr_1.2fr] gap-10 lg:gap-16">
      <div class="reveal">
        <p class="mk-eyebrow">FAQ</p>
        <h2 class="mt-4 text-4xl md:text-5xl font-semibold tracking-[-0.04em] leading-[1.05] text-balance">
          Dudas sobre <span class="font-display italic font-normal tracking-normal text-[1.08em]">el precio.</span>
        </h2>
        <p class="mt-5 text-[16px] text-muted-foreground leading-relaxed max-w-sm">
          ¿Algo más? Consulta las <a href="/#faq" class="text-foreground underline underline-offset-4 decoration-border hover:decoration-foreground">preguntas frecuentes</a> de la página principal.
        </p>
      </div>
      <div class="reveal" data-delay="1">
        <Faq client:visible items={faqs} />
      </div>
    </div>
  </section>

  <CtaBand title="Empieza hoy," accent="gratis." subtitle="Sube tu primera nómina y mira lo que SueldIA te cuenta de ella." />
</MarketingLayout>
