---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import { buttonVariants } from "../components/ui/button";
import { Card, CardHeader, CardTitle, CardDescription, CardContent, CardFooter } from "../components/ui/card";
import { Badge } from "../components/ui/badge";
import { Check } from "lucide-react";

const plans = [
  {
    name: "Gratis",
    price: "0€",
    period: "para siempre",
    description: "Todo lo que necesitas para gestionar tus nóminas hoy.",
    features: [
      "Nóminas y perfiles ilimitados",
      "Extracción automática de conceptos",
      "Dashboard y análisis financiero",
      "Alertas configurables",
      "Cuentas, categorías e importación YNAB",
    ],
    cta: "Empezar gratis",
    href: "/login",
    highlighted: true,
    available: true,
  },
  {
    name: "Pro",
    price: "?",
    period: "próximamente",
    description: "Para cuando el plan gratuito se quede corto.",
    features: [
      "Todo lo del plan Gratis",
      "Historial y copias de seguridad ampliadas",
      "Soporte prioritario",
    ],
    cta: "Próximamente",
    href: null,
    highlighted: false,
    available: false,
  },
];
---

<MarketingLayout title="Precios" description="SueldIA es gratis. Así de simple.">
  <section class="max-w-4xl mx-auto px-4 md:px-8 pt-20 pb-12 text-center">
    <h1 class="text-4xl md:text-5xl font-bold tracking-tight">Precios simples</h1>
    <p class="mt-6 text-lg text-muted-foreground max-w-xl mx-auto text-balance">
      Hoy por hoy, SueldIA es completamente gratuito. Esto es lo que hay y lo que vendrá.
    </p>
  </section>

  <section class="max-w-4xl mx-auto px-4 md:px-8 pb-24">
    <div class="grid sm:grid-cols-2 gap-6">
      {plans.map((plan) => (
        <Card className={plan.highlighted ? "ring-2 ring-primary" : ""}>
          <CardHeader>
            {plan.highlighted && <Badge className="w-fit mb-2">Disponible ahora</Badge>}
            <CardTitle className="text-xl">{plan.name}</CardTitle>
            <CardDescription>{plan.description}</CardDescription>
            <div class="mt-4 flex items-baseline gap-1.5">
              <span class="text-4xl font-bold tracking-tight">{plan.price}</span>
              <span class="text-sm text-muted-foreground">{plan.period}</span>
            </div>
          </CardHeader>
          <CardContent>
            <ul class="space-y-2.5">
              {plan.features.map((feature) => (
                <li class="flex items-start gap-2 text-sm">
                  <Check className="w-4 h-4 text-primary mt-0.5 shrink-0" />
                  <span class={plan.available ? "" : "text-muted-foreground"}>{feature}</span>
                </li>
              ))}
            </ul>
          </CardContent>
          <CardFooter>
            {plan.available ? (
              <a href={plan.href!} class={buttonVariants() + " w-full"}>{plan.cta}</a>
            ) : (
              <span class={buttonVariants({ variant: "outline" }) + " w-full pointer-events-none opacity-60"}>{plan.cta}</span>
            )}
          </CardFooter>
        </Card>
      ))}
    </div>

    <p class="mt-8 text-center text-sm text-muted-foreground">
      ¿Preguntas sobre el plan Pro? Todavía no hay fecha — de momento, disfruta del plan gratuito sin límites.
    </p>
  </section>
</MarketingLayout>
