---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import CtaBand from "../components/marketing/CtaBand.astro";
import {
  FileScan, LayoutDashboard, Users, ShieldCheck, BellRing, TrendingUp,
  FileSpreadsheet, Tags, Wallet, Repeat, KeyRound, DatabaseZap,
} from "lucide-react";

const groups = [
  {
    id: "nominas",
    title: "Nóminas",
    description: "El núcleo de la aplicación: convertir un PDF en datos utilizables.",
    items: [
      {
        icon: FileScan,
        title: "Extracción automática",
        description: "Reconoce nóminas de empresa privada y de organismos públicos, y extrae periodo, empresa, salario bruto/neto y cada concepto (devengos y deducciones) por separado.",
      },
      {
        icon: DatabaseZap,
        title: "Sin guardar el PDF",
        description: "Se procesa el archivo al subirlo y solo se guarda el texto y los conceptos ya estructurados — el PDF original no se almacena en ningún sitio.",
      },
      {
        icon: Repeat,
        title: "Reprocesar cuando quieras",
        description: "Si mejora el motor de extracción, puedes volver a analizar tus nóminas ya guardadas sin tener que subir el PDF otra vez.",
      },
    ],
  },
  {
    id: "analisis",
    title: "Análisis",
    description: "Convierte cada nómina en una visión clara de tu situación.",
    items: [
      {
        icon: LayoutDashboard,
        title: "Dashboard financiero",
        description: "Evolución mensual y anual de tu bruto y tu neto, retención media de IRPF, y desglose de cada concepto a lo largo del tiempo.",
      },
      {
        icon: TrendingUp,
        title: "Comparativas y previsión",
        description: "Compara un año con el anterior y proyecta tu salario anual, incluidas las pagas extra.",
      },
      {
        icon: BellRing,
        title: "Alertas configurables",
        description: "Recibe un aviso si tu nómina baja de lo esperado, si falta algún mes o si un concepto cambia bruscamente.",
      },
    ],
  },
  {
    id: "finanzas",
    title: "Finanzas personales",
    description: "Tu nómina es solo el principio — conéctala con el resto de tu economía.",
    items: [
      {
        icon: Wallet,
        title: "Cuentas y movimientos",
        description: "Lleva varias cuentas (banco, efectivo, tarjeta) con sus ingresos y gastos, todo en un mismo sitio.",
      },
      {
        icon: Tags,
        title: "Categorías personalizables",
        description: "Organiza tus movimientos en grupos y categorías a tu medida para ver en qué se va realmente el dinero.",
      },
      {
        icon: FileSpreadsheet,
        title: "Importación desde YNAB",
        description: "¿Ya llevas tus cuentas en YNAB? Importa tu histórico de un CSV sin volver a introducir nada a mano.",
      },
    ],
  },
  {
    id: "privacidad",
    title: "Cuenta y privacidad",
    description: "Lo mínimo imprescindible, y solo visible para ti.",
    items: [
      {
        icon: Users,
        title: "Varios perfiles por cuenta",
        description: "Gestiona las nóminas de más de una persona (pareja, hijos) desde la misma cuenta, cada una con su propio historial.",
      },
      {
        icon: KeyRound,
        title: "Acceso protegido con Google",
        description: "Inicia sesión con tu cuenta de Google — sin contraseñas que recordar ni gestionar, y cada cuenta completamente aislada del resto.",
      },
      {
        icon: ShieldCheck,
        title: "Datos mínimos",
        description: "No se pide ni se guarda más información de la necesaria para procesar tus nóminas y mostrarte el análisis.",
      },
    ],
  },
];
---

<MarketingLayout title="Características" description="Extracción automática de nóminas, dashboard financiero, alertas y gestión de finanzas personales — todo en SueldIA.">
  <section class="relative isolate">
    <div class="absolute inset-x-0 top-0 h-[520px] mk-dots -z-10" aria-hidden="true"></div>
    <div class="absolute inset-x-0 top-0 h-[560px] mk-halo -z-10" aria-hidden="true"></div>

    <div class="max-w-4xl mx-auto px-5 md:px-8 pt-32 md:pt-40 pb-6 text-center">
      <p class="reveal mk-eyebrow">Características</p>
      <h1 class="reveal mt-5 text-[2.6rem] sm:text-6xl md:text-7xl font-semibold tracking-[-0.045em] leading-[1.02] text-balance" data-delay="1">
        Todo lo que hace <span class="font-display italic font-normal tracking-[-0.02em] text-[1.08em] text-primary-700 dark:text-primary-300">SueldIA.</span>
      </h1>
      <p class="reveal mt-6 text-[17px] md:text-xl text-muted-foreground max-w-xl mx-auto text-balance leading-relaxed" data-delay="2">
        Desde leer el PDF de tu nómina hasta entender tu economía completa.
      </p>
      <nav class="reveal mt-9 flex flex-wrap justify-center gap-2" data-delay="3" aria-label="Secciones">
        {groups.map((g) => (
          <a href={`#${g.id}`} class="rounded-full ring-1 ring-border bg-card/70 dark:bg-white/[0.03] px-4 py-2 text-[13px] text-foreground/75 hover:text-foreground hover:ring-foreground/20 transition">{g.title}</a>
        ))}
      </nav>
    </div>
  </section>

  <div class="max-w-6xl mx-auto px-5 md:px-8 pt-12 md:pt-20 space-y-20 md:space-y-28">
    {groups.map((group, gi) => (
      <section id={group.id} class="scroll-mt-24 grid lg:grid-cols-[0.75fr_1.6fr] gap-8 lg:gap-14">
        <div class="reveal lg:sticky lg:top-28 self-start">
          <p class="text-[13px] font-medium text-primary-700 dark:text-primary-300 tabular-nums">{String(gi + 1).padStart(2, "0")}</p>
          <h2 class="mt-2 text-3xl md:text-4xl font-semibold tracking-[-0.035em] leading-[1.1]">{group.title}</h2>
          {group.description && <p class="mt-3 text-[15.5px] text-muted-foreground leading-relaxed max-w-xs">{group.description}</p>}
        </div>
        <div class="grid sm:grid-cols-2 gap-4">
          {group.items.map(({ icon: Icon, title, description }, i) => (
            <div
              class:list={[
                "reveal mk-card rounded-3xl p-6 sm:p-7 transition-transform duration-300 hover:-translate-y-0.5",
                i === 0 && group.items.length % 2 === 1 && "sm:col-span-2",
              ]}
              data-delay={String(i)}
            >
              <span class="w-10 h-10 rounded-xl bg-primary-50 dark:bg-primary-500/15 text-primary-700 dark:text-primary-300 flex items-center justify-center">
                <Icon className="w-5 h-5" />
              </span>
              <h3 class="mt-5 text-lg font-semibold tracking-tight">{title}</h3>
              <p class="mt-2 text-[14.5px] text-muted-foreground leading-relaxed">{description}</p>
            </div>
          ))}
        </div>
      </section>
    ))}
  </div>

  <CtaBand title="¿Lo pruebas con tu" accent="próxima nómina?" />
</MarketingLayout>
