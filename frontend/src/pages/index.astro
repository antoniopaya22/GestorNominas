---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import { buttonVariants } from "../components/ui/button";
import { Card, CardHeader, CardTitle, CardDescription, CardContent } from "../components/ui/card";
import { Badge } from "../components/ui/badge";
import {
  FileScan, LayoutDashboard, Users, ShieldCheck, BellRing, TrendingUp,
  Upload, Sparkles, LineChart,
} from "lucide-react";

const features = [
  {
    icon: FileScan,
    title: "Extracción automática",
    description: "Sube el PDF de tu nómina y en segundos tienes el bruto, el neto, el IRPF y cada concepto ya organizado — sin rellenar nada a mano.",
  },
  {
    icon: LayoutDashboard,
    title: "Dashboard financiero",
    description: "Evolución de tu salario mes a mes, comparativas anuales, retención de IRPF y previsión de pagas extra, todo en un vistazo.",
  },
  {
    icon: Users,
    title: "Varios perfiles",
    description: "Gestiona las nóminas de toda la familia o de varias fuentes de ingresos, cada una con su propio historial y análisis.",
  },
  {
    icon: BellRing,
    title: "Alertas inteligentes",
    description: "Te avisa si tu nómina baja de lo esperado, si falta algún mes o si un concepto cambia de golpe.",
  },
  {
    icon: TrendingUp,
    title: "Finanzas al completo",
    description: "Cuentas, categorías, gastos e ingresos recurrentes — conecta tu nómina con el resto de tu economía personal.",
  },
  {
    icon: ShieldCheck,
    title: "Tus datos, tu cuenta",
    description: "Cada cuenta ve solo sus propios datos. No se guarda el PDF original, solo la información ya extraída.",
  },
];

const steps = [
  { icon: Upload, title: "Sube tu nómina", description: "Arrastra el PDF — nada de escáneres ni fotos, solo el documento digital." },
  { icon: Sparkles, title: "Se procesa sola", description: "El sistema reconoce el formato y extrae cada concepto automáticamente." },
  { icon: LineChart, title: "Analiza y decide", description: "Consulta tu evolución salarial y tus finanzas en un dashboard claro." },
];
---

<MarketingLayout title="Inicio" description="Sube tus nóminas en PDF y consigue al instante un dashboard con tu evolución salarial, IRPF y alertas — sin rellenar nada a mano.">
  <!-- Hero -->
  <section class="max-w-6xl mx-auto px-4 md:px-8 pt-20 pb-16 md:pt-28 md:pb-24 text-center">
    <Badge variant="secondary" className="mb-6">Nuevo · Extracción sin OCR, directa del PDF</Badge>
    <h1 class="text-4xl md:text-6xl font-bold tracking-tight text-balance max-w-3xl mx-auto">
      Tus nóminas, entendidas automáticamente
    </h1>
    <p class="mt-6 text-lg text-muted-foreground max-w-2xl mx-auto text-balance">
      Sube el PDF de tu nómina y obtén al instante un dashboard con tu bruto, tu neto,
      tus retenciones y su evolución — sin hojas de cálculo ni introducir nada a mano.
    </p>
    <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-3">
      <a href="/login" class={buttonVariants({ size: "lg" }) + " px-8"}>Empezar gratis</a>
      <a href="/caracteristicas" class={buttonVariants({ variant: "outline", size: "lg" }) + " px-8"}>Ver características</a>
    </div>
  </section>

  <!-- Features -->
  <section class="max-w-6xl mx-auto px-4 md:px-8 py-16 md:py-24">
    <div class="text-center mb-12">
      <h2 class="text-3xl font-bold tracking-tight">Todo lo que necesitas para entender tu nómina</h2>
      <p class="mt-3 text-muted-foreground max-w-xl mx-auto">Pensado para nóminas españolas, tanto de empresa privada como de organismos públicos.</p>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {features.map(({ icon: Icon, title, description }) => (
        <Card>
          <CardHeader>
            <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center mb-2">
              <Icon className="w-5 h-5 text-primary" />
            </div>
            <CardTitle>{title}</CardTitle>
            <CardDescription>{description}</CardDescription>
          </CardHeader>
          <CardContent></CardContent>
        </Card>
      ))}
    </div>
  </section>

  <!-- How it works -->
  <section class="border-y border-border bg-muted/30">
    <div class="max-w-6xl mx-auto px-4 md:px-8 py-16 md:py-24">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold tracking-tight">Cómo funciona</h2>
      </div>
      <div class="grid md:grid-cols-3 gap-8">
        {steps.map(({ icon: Icon, title, description }, i) => (
          <div class="text-center">
            <div class="w-12 h-12 rounded-full bg-primary text-primary-foreground flex items-center justify-center mx-auto mb-4 font-bold">
              {i + 1}
            </div>
            <h3 class="font-semibold mb-2">{title}</h3>
            <p class="text-sm text-muted-foreground">{description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="max-w-4xl mx-auto px-4 md:px-8 py-20 md:py-28 text-center">
    <h2 class="text-3xl md:text-4xl font-bold tracking-tight">Empieza a entender tu nómina hoy</h2>
    <p class="mt-4 text-muted-foreground">Gratis, sin tarjeta de crédito.</p>
    <div class="mt-8">
      <a href="/login" class={buttonVariants({ size: "lg" }) + " px-10"}>Crear cuenta gratis</a>
    </div>
  </section>
</MarketingLayout>
