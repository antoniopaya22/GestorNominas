---
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
const currentPath = Astro.url.pathname;
const normalizedCurrentPath = currentPath !== "/" && currentPath.endsWith("/")
  ? currentPath.slice(0, -1)
  : currentPath;

function isActivePath(href: string, exact = false): boolean {
  if (href === "/") {
    return normalizedCurrentPath === "/";
  }

  if (exact) {
    return normalizedCurrentPath === href;
  }

  return normalizedCurrentPath === href || normalizedCurrentPath.startsWith(`${href}/`);
}

const navItems = [
  { href: "/", label: "Inicio", icon: "home" },
  { href: "/finance", label: "Dashboard", icon: "wallet", section: "Finanzas", exact: true },
  { href: "/finance/analytics", label: "Analítica", icon: "analytics" },
  { href: "/accounts", label: "Cuentas", icon: "landmark" },
  { href: "/categories", label: "Categorías", icon: "tags" },
  { href: "/transactions", label: "Transacciones", icon: "receipt" },
  { href: "/import", label: "Importar", icon: "import" },
  { href: "/payroll", label: "Dashboard", icon: "chart", section: "Nóminas" },
  { href: "/upload", label: "Subir Nóminas", icon: "upload" },
  { href: "/payslips", label: "Mis Nóminas", icon: "file" },
  { href: "/analytics", label: "Analítica", icon: "analytics" },
  { href: "/profiles", label: "Perfiles", icon: "users" },
  { href: "/settings", label: "Ajustes", icon: "settings", section: "Sistema" },
];

const mobileNavItems = [
  { href: "/", label: "Inicio", icon: "home" },
  { href: "/finance", label: "Finanzas", icon: "wallet" },
  { href: "/transactions", label: "Movimientos", icon: "receipt" },
  { href: "/payslips", label: "Nóminas", icon: "file" },
  { href: "/settings", label: "Ajustes", icon: "settings" },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Gestor Financiero</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-screen bg-surface-50">
    <div class="flex min-h-screen">
      <!-- Sidebar -->
      <aside class="hidden md:flex w-[260px] flex-col bg-white border-r border-surface-200 fixed inset-y-0 left-0 z-30">
        <!-- Logo -->
        <div class="flex items-center gap-3 px-6 h-16 border-b border-surface-200">
          <div class="w-8 h-8 rounded-lg bg-primary-600 flex items-center justify-center">
            <svg class="w-4.5 h-4.5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
            </svg>
          </div>
          <div>
            <h1 class="text-sm font-bold text-surface-900 leading-tight">Gestor Financiero</h1>
            <p class="text-[11px] text-surface-400 leading-tight">Nóminas y finanzas</p>
          </div>
        </div>

        <!-- Navigation -->
        <nav class="flex-1 px-3 py-4 space-y-1 overflow-y-auto">
          {navItems.map((item) => {
            const isActive = isActivePath(item.href, item.exact ?? false);
            return (
              <>
                {item.section && (
                  <p class="text-[10px] font-bold text-surface-400 uppercase tracking-widest px-3 pt-4 pb-1 first:pt-0">{item.section}</p>
                )}
                <a
                  href={item.href}
                  class:list={[
                    "group flex items-center gap-3 px-3 py-2.5 rounded-xl text-[13px] font-medium transition-all duration-150 cursor-pointer",
                    isActive
                      ? "bg-primary-50 text-primary-700 shadow-sm"
                      : "text-surface-600 hover:bg-surface-100 hover:text-surface-900",
                  ]}
                >
                  {item.icon === "home" && (
                    <svg class:list={["w-[18px] h-[18px] transition-colors", isActive ? "text-primary-600" : "text-surface-400 group-hover:text-surface-600"]} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"/><path d="M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                    </svg>
                  )}
                  {item.icon === "wallet" && (
                    <svg class:list={["w-[18px] h-[18px] transition-colors", isActive ? "text-primary-600" : "text-surface-400 group-hover:text-surface-600"]} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M19 7V4a1 1 0 0 0-1-1H5a2 2 0 0 0 0 4h15a1 1 0 0 1 1 1v4h-3a2 2 0 0 0 0 4h3a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1"/><path d="M3 5v14a2 2 0 0 0 2 2h15a1 1 0 0 0 1-1v-4"/>
                    </svg>
                  )}
                  {item.icon === "landmark" && (
                    <svg class:list={["w-[18px] h-[18px] transition-colors", isActive ? "text-primary-600" : "text-surface-400 group-hover:text-surface-600"]} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <line x1="3" x2="21" y1="22" y2="22"/><line x1="6" x2="6" y1="18" y2="11"/><line x1="10" x2="10" y1="18" y2="11"/><line x1="14" x2="14" y1="18" y2="11"/><line x1="18" x2="18" y1="18" y2="11"/><polygon points="12 2 20 7 4 7"/>
                    </svg>
                  )}
                  {item.icon === "receipt" && (
                    <svg class:list={["w-[18px] h-[18px] transition-colors", isActive ? "text-primary-600" : "text-surface-400 group-hover:text-surface-600"]} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1Z"/><path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"/><path d="M12 17.5v-11"/>
                    </svg>
                  )}
                  {item.icon === "import" && (
                    <svg class:list={["w-[18px] h-[18px] transition-colors", isActive ? "text-primary-600" : "text-surface-400 group-hover:text-surface-600"]} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 3v12"/><path d="m8 11 4 4 4-4"/><path d="M8 5H4a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-4"/>
                    </svg>
                  )}
                  {item.icon === "chart" && (
                    <svg class:list={["w-[18px] h-[18px] transition-colors", isActive ? "text-primary-600" : "text-surface-400 group-hover:text-surface-600"]} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/>
                    </svg>
                  )}
                  {item.icon === "upload" && (
                    <svg class:list={["w-[18px] h-[18px] transition-colors", isActive ? "text-primary-600" : "text-surface-400 group-hover:text-surface-600"]} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/>
                    </svg>
                  )}
                  {item.icon === "file" && (
                    <svg class:list={["w-[18px] h-[18px] transition-colors", isActive ? "text-primary-600" : "text-surface-400 group-hover:text-surface-600"]} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 13H8"/><path d="M16 17H8"/><path d="M16 13h-2"/>
                    </svg>
                  )}
                  {item.icon === "users" && (
                    <svg class:list={["w-[18px] h-[18px] transition-colors", isActive ? "text-primary-600" : "text-surface-400 group-hover:text-surface-600"]} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                    </svg>
                  )}
                  {item.icon === "analytics" && (
                    <svg class:list={["w-[18px] h-[18px] transition-colors", isActive ? "text-primary-600" : "text-surface-400 group-hover:text-surface-600"]} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/><ellipse cx="12" cy="5" rx="9" ry="3"/>
                    </svg>
                  )}
                  {item.icon === "tags" && (
                    <svg class:list={["w-[18px] h-[18px] transition-colors", isActive ? "text-primary-600" : "text-surface-400 group-hover:text-surface-600"]} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="m15 5 6.3 6.3a2.4 2.4 0 0 1 0 3.4L17 19"/><path d="M9.586 5.586A2 2 0 0 0 8.172 5H3a1 1 0 0 0-1 1v5.172a2 2 0 0 0 .586 1.414L8 18.414a2 2 0 0 0 2.828 0L15 14.243"/><circle cx="6.5" cy="9.5" r=".5" fill="currentColor"/>
                    </svg>
                  )}
                  {item.icon === "settings" && (
                    <svg class:list={["w-[18px] h-[18px] transition-colors", isActive ? "text-primary-600" : "text-surface-400 group-hover:text-surface-600"]} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/>
                    </svg>
                  )}
                  <span>{item.label}</span>
                </a>
              </>
            );
          })}
        </nav>

        <!-- Footer -->
        <div class="px-4 py-3 border-t border-surface-200">
          <p class="text-[11px] text-surface-400 text-center">v2.0 · Datos locales</p>
        </div>
      </aside>

      <!-- Mobile header -->
      <header class="md:hidden fixed top-0 left-0 right-0 h-14 bg-white border-b border-surface-200 z-30 flex items-center px-4 gap-3">
        <div class="w-7 h-7 rounded-lg bg-primary-600 flex items-center justify-center flex-shrink-0">
          <svg class="w-3.5 h-3.5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
          </svg>
        </div>
        <span class="text-sm font-bold text-surface-900">Gestor Financiero</span>
      </header>

      <!-- Mobile bottom nav -->
      <nav class="md:hidden fixed bottom-0 left-0 right-0 h-16 bg-white border-t border-surface-200 z-30 flex items-center justify-around px-2">
        {mobileNavItems.map((item) => {
          const isActive = isActivePath(item.href);
          return (
            <a
              href={item.href}
              class:list={[
                "flex flex-col items-center gap-1 px-3 py-1.5 rounded-lg transition-colors cursor-pointer",
                isActive ? "text-primary-600" : "text-surface-400",
              ]}
            >
              {item.icon === "home" && (
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"/><path d="M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                </svg>
              )}
              {item.icon === "wallet" && (
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M19 7V4a1 1 0 0 0-1-1H5a2 2 0 0 0 0 4h15a1 1 0 0 1 1 1v4h-3a2 2 0 0 0 0 4h3a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1"/><path d="M3 5v14a2 2 0 0 0 2 2h15a1 1 0 0 0 1-1v-4"/>
                </svg>
              )}
              {item.icon === "receipt" && (
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1Z"/><path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"/><path d="M12 17.5v-11"/>
                </svg>
              )}
              {item.icon === "chart" && (
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/>
                </svg>
              )}
              {item.icon === "file" && (
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/>
                </svg>
              )}
              {item.icon === "users" && (
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/>
                </svg>
              )}
              {item.icon === "settings" && (
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/>
                </svg>
              )}
              <span class="text-[10px] font-medium">{item.label}</span>
            </a>
          );
        })}
      </nav>

      <!-- Main content -->
      <main class="flex-1 md:ml-[260px] mt-14 md:mt-0 mb-16 md:mb-0 overflow-auto min-h-screen">
        <div class="px-4 py-6 md:px-8 md:py-8 max-w-7xl mx-auto">
          <slot />
        </div>
      </main>
    </div>

  </body>
</html>
