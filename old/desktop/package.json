{
  "name": "gestor-nominas-desktop",
  "version": "1.0.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.antoniopaya.gestornominas",
    "productName": "Gestor de Nóminas",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": ["main.js", "backend-manager.js", "splash.html", "package.json"],
    "extraResources": [
      { "from": "../backend/dist", "to": "app/backend/dist" },
      { "from": "../backend/node_modules", "to": "app/backend/node_modules" },
      { "from": "../backend/package.json", "to": "app/backend/package.json" },
      { "from": "../frontend/dist", "to": "app/frontend/dist" },
      { "from": "resources/node", "to": "node" },
      { "from": "resources/tessdata", "to": "tessdata" }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
