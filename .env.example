# ─── SueldIA — Variables de entorno ───────────────────────────────
# Copia este archivo como .env y ajusta los valores según tu entorno.

# Puerto del servidor backend (solo se usa en local; Vercel ignora esto)
PORT=3001

# Entorno: development | production | test
NODE_ENV=development

# Orígenes permitidos para CORS, separados por comas si hay varios (dominio
# de producción + previews de Vercel, por ejemplo). El frontend en producción
# llama a /api en el mismo origen (rewrite de Vercel) y no depende de esto,
# pero cualquier otro origen queda bloqueado si no aparece aquí.
CORS_ORIGIN=http://localhost:4321

# Connection string de Postgres (Supabase). Usa el Transaction Pooler
# (puerto 6543), no la conexión directa — es el recomendado para entornos
# serverless. Project Settings → Database → Connection string.
DATABASE_URL=postgresql://user:password@host:6543/postgres

# URL del proyecto de Supabase (NO la de la BBDD) — se usa para verificar los
# tokens que emite Supabase Auth. Project Settings → API → Project URL.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# ─── Frontend (Astro) ──────────────────────────────────────────────
# Mismo proyecto de Supabase, valores públicos (van al bundle del navegador).
# Project Settings → API → Project URL / anon public key.
PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=change-me
